rules_version = '2';

// Rules for the whole bucket remimbers.firebasestorage.app. Remimbers itself
// stores nothing here (27 Oct 2026). If it ever does, its rules must be merged
// into THIS file, because a bucket has one rules file.
//
// Layout:
//   highlights/{uid}/{uploadId}.jpg             a photo of a paper page
//   highlights/{uid}/{uploadId}/p{N}.jpg        a prepared page of a PDF (what the model saw)
//   highlights/{uid}/{uploadId}/original.pdf    the PDF itself, if it was 30 MB or less
//
// Nothing can be overwritten or deleted from the app: pages are kept so new
// prompts can be re-run on exactly what the model saw.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Uploading over an existing file also counts as `create`, so "never
    // overwrite" needs this explicit check (found by scripts/rules-test.mjs, 27 Oct).
    function isNew() {
      return resource == null;
    }

    // NOT the invite list, only a verified email. A cross-service lookup of the
    // allowlist (firestore.exists(/databases/highlights/documents/allowlist/...))
    // passed in the emulator but was denied in production on 27 Oct 2026, even
    // with the Storage service agent holding roles/firebaserules.firestoreServiceAgent;
    // most likely production only supports the (default) database. Known gap: an
    // uninvited Google account can store files in its own folder, but can't make
    // cards (that needs a Firestore write the invite list guards).
    function isInvited() {
      return request.auth.token.email_verified == true;
    }

    // Photos.
    match /highlights/{uid}/{file} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isNew() && isInvited()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // PDF uploads: prepared page images and the original file.
    match /highlights/{uid}/{uploadId}/{file} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isNew() && isInvited() && (
        (file.matches('p[0-9]+[.]jpg')
          && request.resource.contentType == 'image/jpeg'
          && request.resource.size < 10 * 1024 * 1024)
        || (file == 'original.pdf'
          && request.resource.contentType == 'application/pdf'
          && request.resource.size <= 30 * 1024 * 1024)
      );
    }
  }
}
